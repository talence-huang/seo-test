{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "runs-viewer",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "runs"
      ],
      "port": 8765
    },
    {
      "name": "web-ui",
      "runtimeExecutable": ".venv/Scripts/seo-intel.exe",
      "runtimeArgs": [
        "web",
        "--no-open",
        "--port",
        "8766"
      ],
      "port": 8766
    }
  ]
}